model LeaveType {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  isPaid      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdBy   String?
  updatedBy   String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("leave_types")
}

model Team {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("teams")
}

// -----------------------------------------------------------------------------
// USER MANAGEMENT (EMPLOYEE & CUSTOMER)
// -----------------------------------------------------------------------------

model Employee {
  id                     String    @id @default(uuid())
  tenantId               String
  employeeCode           String
  userId                 String?   @unique
  companyId              String?
  departmentId           String?
  designationId          String?
  branchId               String?
  teamId                 String?
  regionId               String?
  businessUnitId         String?
  firstName              String
  middleName             String?
  lastName               String
  displayName            String?
  gender                 String?
  maritalStatus          String?
  nationality            String?
  bloodGroup             String?
  dateOfBirth            DateTime?
  photograph             String?
  primaryMobile          String?
  alternateMobile        String?
  primaryEmail           String?
  alternateEmail         String?
  emergencyContactName   String?
  emergencyContactNumber String?
  employmentType         String? // Permanent, Contract, etc.
  employmentStatus       String    @default("ACTIVE") // ACTIVE, RESIGNED, SUSPENDED
  joiningDate            DateTime?
  confirmationDate       DateTime?
  workLocation           String?
  reportingManagerId     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?

  // Relations
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id])
  company               Company?               @relation(fields: [companyId], references: [id])
  department            Department?            @relation(fields: [departmentId], references: [id])
  designation           Designation?           @relation(fields: [designationId], references: [id])
  branch                Branch?                @relation(fields: [branchId], references: [id])
  team                  Team?                  @relation(fields: [teamId], references: [id])
  region                Region?                @relation(fields: [regionId], references: [id])
  businessUnit          BusinessUnit?          @relation(fields: [businessUnitId], references: [id])
  reportingManager      Employee?              @relation("EmployeeToManager", fields: [reportingManagerId], references: [id])
  subordinates          Employee[]             @relation("EmployeeToManager")
  attendances           Attendance[]
  attendanceSessions    AttendanceSession[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]         @relation("EmployeeLeaveRequests")
  approvedLeaves        LeaveRequest[]         @relation("LeaveApprover")
  attendanceCorrections AttendanceCorrection[]
  shiftAssignments      ShiftAssignment[]
  employeeLocations     EmployeeLocation[]
  gpsValidationLogs     GpsValidationLog[]
  offlineQueues         OfflineQueue[]
  salaryStructures      SalaryStructure[]
  payslips              Payslip[]
  expenseClaims         ExpenseClaim[]
  devices               EmployeeDevice[]
  visits                Visit[]

  @@unique([tenantId, employeeCode])
  @@unique([id, tenantId])
  @@index([tenantId, companyId])
  @@index([tenantId, departmentId])
  @@index([tenantId, branchId])
  @@index([tenantId, designationId])
  @@index([tenantId, teamId])
  @@index([tenantId, reportingManagerId])
  @@index([tenantId, regionId])
  @@index([tenantId, businessUnitId])
  @@map("employees")
}

model Customer {
  id                 String    @id @default(uuid())
  tenantId           String
  companyId          String?
  customerCode       String
  legalName          String
  displayName        String?
  customerType       String? // Enterprise, SME, Retail
  status             String    @default("ACTIVE")
  primaryEmail       String?
  primaryMobile      String?
  gstVat             String?
  registrationNumber String?
  website            String?
  industry           String?
  accountManagerId   String?
  notes              String?
  metadata           Json?
  parentCustomerId   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company?   @relation(fields: [companyId], references: [id])
  accountManager     User?      @relation("CustomerAccountManager", fields: [accountManagerId], references: [id])
  parentCustomer     Customer?  @relation("ParentCustomer", fields: [parentCustomerId], references: [id])
  childCustomers     Customer[] @relation("ParentCustomer")
  faults             Fault[]
  visits             Visit[]
  convertedFromLeads Lead[]                 @relation("LeadConvertedCustomer")
  portalUsers        CustomerPortalUser[]
  portalInvites      CustomerPortalInvite[]
  networkConnections NetworkConnection[]

  @@unique([tenantId, customerCode])
  @@unique([id, tenantId])
  @@index([tenantId, companyId])
  @@index([tenantId, parentCustomerId])
  @@index([tenantId, accountManagerId])
  @@index([tenantId, createdAt])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// CRM MODULE (LEADS)
// -----------------------------------------------------------------------------

model PipelineStage {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("pipeline_stages")
}

model LeadStatus {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("lead_statuses")
}

model LeadSource {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("lead_sources")
}

model Campaign {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("campaigns")
}

model LeadPriority {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads  Lead[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("lead_priorities")
}

model Lead {
  id                  String    @id @default(uuid())
  tenantId            String
  leadNumber          String
  firstName           String
  lastName            String?
  companyName         String?
  mobile              String?
  alternateMobile     String?
  email               String?
  expectedValue       Float?
  currencyCode        String?
  qualificationScore  Int?
  sourceId            String?
  campaignId          String?
  priorityId          String?
  ownerUserId         String?
  statusId            String?
  pipelineStageId     String?
  tags                Json?
  customFields        Json?
  // Customer conversion traceability (3.4 CUSTOMER_CONVERSION.md §4)
  convertedCustomerId String?
  convertedAt         DateTime?
  createdAt           DateTime  @default(now())
