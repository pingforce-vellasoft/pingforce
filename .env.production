# Production Database Settings
# Note: DB_HOST is "postgres" because it connects via the Docker internal network!
DB_USER=pingforce_user
DB_PASSWORD=pingforce_password
DB_NAME=pingforce_db
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://pingforce_user:pingforce_password@postgres:5432/pingforce_db?schema=public

# Production Redis Settings
# Note: REDIS_HOST is "redis" because it connects via the Docker internal network!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Authentication
# IMPORTANT: Change this to a highly secure, random string for production!
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# App Config
PORT=3000
NODE_ENV=production
# Update this if you host an admin portal on a specific domain
ALLOWED_ORIGINS=https://pingforce.in,https://admin.pingforce.in
