# Database
DB_USER=pingforce_user
DB_PASSWORD=pingforce_password
DB_NAME=pingforce_db
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql://pingforce_user:pingforce_password@localhost:5432/pingforce_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_ENDPOINT=localhost
MINIO_PORT=9000

# Auth
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Firebase (FCM push via Admin SDK) — point at a service-account key file
# kept in the gitignored secrets/ directory. Alternatively set
# FIREBASE_SERVICE_ACCOUNT_JSON to the base64-encoded key JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/your-firebase-adminsdk.json

# WhatsApp Cloud API (optional — messages are logged when unset)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Global (system) SMTP — used for platform-level mail before a tenant has its
# own email provider configured, e.g. the tenant-admin welcome/invite on
# tenant creation. When SMTP_HOST is unset, emails are logged, NOT delivered.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@pingforce.in

# Onboarding links embedded in the tenant welcome email.
# ADMIN_WEB_URL=https://admin.pingforce.in
# MOBILE_ANDROID_URL=https://play.google.com/store/apps/details?id=in.pingforce.app

# Per-tenant email providers (Email.md §5) — 32-byte key (hex or base64)
# used to seal tenant SMTP passwords (AES-256-GCM). From OCI Vault in prod.
# EMAIL_CONFIG_ENCRYPTION_KEY=

# Object storage for file uploads (Upload.md/Storage.md). When unset, files
# are stored on local disk under uploads/. S3-compatible — works with the
# local MinIO container and OCI Object Storage's S3-compat endpoint.
# OBJECT_STORAGE_ENDPOINT=localhost
# OBJECT_STORAGE_PORT=9000
# OBJECT_STORAGE_USE_SSL=false
# OBJECT_STORAGE_ACCESS_KEY=admin
# OBJECT_STORAGE_SECRET_KEY=admin123
# OBJECT_STORAGE_BUCKET=pingforce-files

# Database connection pool (optional overrides)
# DB_POOL_MAX=30
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONNECTION_TIMEOUT=5000

# App
PORT=3000
NODE_ENV=development
