generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Note: In Prisma 7, the connection URL is configured in prisma.config.ts, NOT here.
  // See prisma/prisma.config.ts for the DATABASE_URL configuration.
}

// -----------------------------------------------------------------------------
// TENANT MODULE (Foundation for Multi-Tenancy)
// -----------------------------------------------------------------------------

model Tenant {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  domain    String?   @unique
  status    String    @default("ACTIVE") // ACTIVE, SUSPENDED
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  // Contact & Company Details
  legalName    String?
  contactEmail String?
  contactPhone String?
  industry     String?

  // Billing & Invoicing
  billingEmail String?
  taxId        String?
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?

  // Subscription Details
  subscriptionStatus String    @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELLED
  subscriptionPlan   String    @default("BASIC") // BASIC, PROFESSIONAL, ENTERPRISE
  subscriptionStart  DateTime?
  subscriptionEnd    DateTime?

  // Localization & Branding
  timezone   String? @default("UTC")
  currency   String? @default("USD")
  themeColor String?

  // Module Provisioning
  isAttendanceEnabled Boolean @default(true)
  maxFieldStaff       Int?

  // Relations
  users                 User[]
  sessions              Session[]
  companies             Company[]
  departments           Department[]
  designations          Designation[]
  branches              Branch[]
  regions               Region[]
  businessUnits         BusinessUnit[]
  leaveTypes            LeaveType[]
  employees             Employee[]
  customers             Customer[]
  pipelineStages        PipelineStage[]
  leadStatuses          LeadStatus[]
  leads                 Lead[]
  shifts                Shift[]
  attendances           Attendance[]
  attendanceSessions    AttendanceSession[]
  teams                 Team[]
  leadSources           LeadSource[]
  campaigns             Campaign[]
  leadPriorities        LeadPriority[]
  attendancePolicies    AttendancePolicy[]
  leaveBalances         LeaveBalance[]
  leaveRequests         LeaveRequest[]
  attendanceBreaks      AttendanceBreak[]
  attendanceCorrections AttendanceCorrection[]
  shiftAssignments      ShiftAssignment[]
  geofences             Geofence[]
  employeeLocations     EmployeeLocation[]
  gpsValidationLogs     GpsValidationLog[]
  offlineQueues         OfflineQueue[]
  syncLogs              SyncLog[]
  auditLogs             AuditLog[]
  salaryStructures      SalaryStructure[]
  slaPolicies           SlaPolicy[]
  payrollCycles         PayrollCycle[]
  payslips              Payslip[]
  expenseCategories     ExpenseCategory[]
  expenseClaims         ExpenseClaim[]
  claimTimelines        ClaimTimeline[]
  faults                Fault[]
  faultTimelines        FaultTimeline[]
  visits                Visit[]
  visitStatusHistory    VisitStatusHistory[]
  visitNotes            VisitNote[]

  roles                 Role[]
  tenantSettings        TenantSetting?
  fileAttachments       FileAttachment[]
  notificationTemplates NotificationTemplate[]
  notificationLogs      NotificationLog[]
  loginHistory          LoginHistory[]
  emailConfig           TenantEmailConfig?
  userScopeOverrides    UserScopeOverride[]
  workflowDefinitions   WorkflowDefinition[]
  workflowStages        WorkflowStage[]
  workflowInstances     WorkflowInstance[]
  workflowActions       WorkflowAction[]
  workflowDelegations   WorkflowDelegation[]
  auditChainHead        AuditChainHead?
  auditRetentionPolicy  AuditRetentionPolicy?
  auditArchive          AuditArchive[]
  auditExports          AuditExport[]
  oltes                 Olte[]
  networkConnections    NetworkConnection[]
  connectionHistories   ConnectionHistory[]
  subscriptions         TenantSubscription[]
  paymentTransactions   PaymentTransaction[]
  portalUsers           CustomerPortalUser[]
  portalInvites         CustomerPortalInvite[]

  @@map("tenants")
}

// -----------------------------------------------------------------------------
// AUTH & USERS MODULE
// -----------------------------------------------------------------------------

model SuperAdmin {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  status       String    @default("ACTIVE")
  tokenVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  refreshTokens RefreshToken[]

  @@map("super_admins")
}

model User {
  id           String  @id @default(uuid())
  tenantId     String
  email        String?
  phone        String?
  passwordHash String
  clientCode   String? // A unique code for the user within a tenant (e.g., employee ID)

  roleId       String?
  role         Role?     @relation(fields: [roleId], references: [id])
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  tokenVersion Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?

  // Relations
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  profile              UserProfile?
  sessions             Session[]
  refreshTokens        RefreshToken[]
  otpCodes             OtpCode[]
  deviceTokens         DeviceToken[]
  employee             Employee?
  leads                Lead[]                 @relation("LeadOwner")
  customers            Customer[]             @relation("CustomerAccountManager")
  approvedCorrections  AttendanceCorrection[]
  assignedFaults       Fault[]                @relation("FaultAssignee")
  escalatedSlaPolicies SlaPolicy[]            @relation("SlaEscalationUser")
  scopeOverrides       UserScopeOverride[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([tenantId, clientCode])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("users")
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String
  lastName  String
  avatar    String?
  gender    String?
  dob       DateTime?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Session {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  deviceId       String?
  platform       String? // WEB, MOBILE, API
  ip             String?
  userAgent      String?
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  revokeReason   String? // LOGOUT, LOGOUT_ALL, ADMIN_REVOKE, TOKEN_REPLAY, PASSWORD_RESET
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String?
  superAdminId String?
  portalUserId String? // customer portal identity (3.8_CustomerPortal)
  tenantId     String
  sessionId    String?
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String? // ROTATED, LOGOUT, LOGOUT_ALL, TOKEN_REPLAY, PASSWORD_RESET
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin?         @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  portalUser CustomerPortalUser? @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([userId])
  @@index([superAdminId])
  @@index([portalUserId])
  @@index([tenantId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// CUSTOMER PORTAL — END-USER IDENTITY (3.8_CustomerPortal)
// Portal users are a separate identity type from staff Users: they belong to a
// Customer account, never hold staff RBAC roles, and can never satisfy a staff
// permission check (BRD 3.8 BR-9.1).
// -----------------------------------------------------------------------------

model CustomerPortalUser {
  id           String    @id @default(uuid())
  tenantId     String
  customerId   String
  email        String?
  phone        String?
  passwordHash String? // null = OTP-only login
  firstName    String
  lastName     String?
  status       String    @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED
  isPrimary    Boolean   @default(false)
  portalRole   String    @default("MEMBER") // OWNER, MEMBER, VIEWER
  tokenVersion Int       @default(1)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer                 @relation(fields: [customerId], references: [id])
  refreshTokens RefreshToken[]
  otpCodes      CustomerPortalOtp[]
  invites       CustomerPortalInvite[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@unique([id, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("customer_portal_users")
}

model CustomerPortalInvite {
  id           String    @id @default(uuid())
  tenantId     String
  customerId   String
  email        String?
  phone        String?
  firstName    String
  lastName     String?
  tokenHash    String    @unique // SHA-256 of the opaque invite token — never plaintext
  portalRole   String    @default("MEMBER") // OWNER, MEMBER, VIEWER
  status       String    @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String // staff User id (or portal OWNER id, prefixed handling in service)
  portalUserId String? // set once accepted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer            @relation(fields: [customerId], references: [id])
  portalUser CustomerPortalUser? @relation(fields: [portalUserId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("customer_portal_invites")
}

// Mirrors OtpCode for portal identities (OtpCode is FK-bound to staff Users).
model CustomerPortalOtp {
  id             String    @id @default(uuid())
  tenantId       String
  portalUserId   String
  otp            String // SHA-256 hash — never plaintext
  purpose        String // LOGIN, ACTIVATION, PASSWORD_RESET, CONTACT_CHANGE
  channel        String    @default("EMAIL") // EMAIL, SMS
  failedAttempts Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  portalUser CustomerPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([portalUserId, purpose])
  @@index([tenantId])
  @@map("customer_portal_otps")
}

model OtpCode {
  id             String    @id @default(uuid())
  tenantId       String?
  userId         String
  otp            String // SHA-256 hash of the OTP — never plaintext
  purpose        String // e.g., PASSWORD_RESET, LOGIN
  channel        String    @default("EMAIL") // EMAIL, SMS
  failedAttempts Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([tenantId])
  @@map("otp_codes")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  fcmToken   String
  platform   String? // ANDROID, IOS, WEB
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("device_tokens")
}

// Immutable authentication-activity trail (LoginHistory.md §5/§13). Tenant
// users only — SYSTEM (super-admin) logins have no Tenant row to reference.
model LoginHistory {
  id            String    @id @default(uuid())
  tenantId      String
  userId        String?
  username      String // identifier as presented (email or phone)
  authMethod    String    @default("PASSWORD") // PASSWORD, REFRESH_TOKEN, GOOGLE
  outcome       String // SUCCESS, UNKNOWN_ACCOUNT, INVALID_PASSWORD, ACCOUNT_INACTIVE, PORTAL_RESTRICTED, TOKEN_REPLAY
  sessionId     String?
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  logoutAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, outcome])
  @@index([sessionId])
  @@map("login_history")
}

// -----------------------------------------------------------------------------
// MASTER DATA MODULE
// -----------------------------------------------------------------------------

model Company {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  customers Customer[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("companies")
}

