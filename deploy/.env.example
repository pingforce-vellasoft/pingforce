# Copy to /opt/pingforce/.env on the server and fill in real values.
# NEVER commit the filled-in file.

# GHCR image path, e.g. your-org/pingforce-monorepo (lowercase)
GITHUB_REPO=your-org/your-repo

# Postgres
DB_USER=pingforce_user
DB_PASSWORD=CHANGE_ME_STRONG
DB_NAME=pingforce_db

# Auth
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# CORS (browser origins only — mobile app needs no entry)
ALLOWED_ORIGINS=https://pingforce.in,https://admin.pingforce.in

# MinIO
MINIO_ACCESS_KEY=pingforce
MINIO_SECRET_KEY=CHANGE_ME_STRONG

# Grafana admin login (grafana.pingforce.in)
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG

# Bull Board queue dashboard (https://api.pingforce.in/queues)
# Leave unset to disable the dashboard entirely.
BULL_BOARD_USER=admin
BULL_BOARD_PASS=CHANGE_ME_STRONG

# Global (system) SMTP — platform mail before a tenant configures its own
# provider (e.g. the tenant-admin welcome email). When SMTP_HOST is unset,
# emails are only logged, NOT delivered. Values below are for Brevo
# (brevo.com) — free 300 emails/day. SMTP_PASS is the Brevo *SMTP key*,
# generated in the Brevo dashboard, NOT the account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_BREVO_LOGIN_EMAIL
SMTP_PASS=CHANGE_ME_BREVO_SMTP_KEY
# From address — its domain must be verified in Brevo (SPF/DKIM) or mail
# lands in spam. Start with a verified sender, move to no-reply@pingforce.in.
SMTP_FROM=no-reply@pingforce.in

# Onboarding links embedded in the tenant welcome email.
ADMIN_WEB_URL=https://admin.pingforce.in
MOBILE_ANDROID_URL=https://play.google.com/store/apps/details?id=in.pingforce.app

# WhatsApp Cloud API (optional until Meta app approved)
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Connection pool tuning (optional)
# DB_POOL_MAX=30
