  date              DateTime
  receiptUrl        String?
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  claimTimelines  ClaimTimeline[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([tenantId, createdAt])
  @@map("expense_claims")
}

model ClaimTimeline {
  id             String   @id @default(uuid())
  tenantId       String
  expenseClaimId String
  status         String
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseClaim ExpenseClaim @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, expenseClaimId])
  @@map("claim_timelines")
}

// -----------------------------------------------------------------------------
// FAULT MANAGEMENT MODULE (Sprint 5 & 6)
// -----------------------------------------------------------------------------

model SlaPolicy {
  id             String  @id @default(uuid())
  tenantId       String
  priority       String // LOW, MEDIUM, HIGH, CRITICAL
  resolveInHours Int
  escalateToId   String? // User ID to escalate to

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  escalationUser User?  @relation("SlaEscalationUser", fields: [escalateToId], references: [id], onDelete: SetNull)

  @@unique([tenantId, priority])
  @@unique([id, tenantId])
  @@map("sla_policies")
}

model Fault {
  id              String    @id @default(uuid())
  tenantId        String
  faultNumber     String
  customerId      String?
  title           String
  description     String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  assignedToId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  slaDeadline     DateTime?
  escalationLevel Int       @default(0)
  isEscalated     Boolean   @default(false)
  // Customer Portal (3.8): portal-raised faults + closure rating
  channel                String  @default("STAFF") // STAFF, PORTAL, MOBILE
  reportedByPortalUserId String?
  customerRating         Int? // 1-5, set by customer after closure
  customerRatingComment  String?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id])
  assignedToUser User?           @relation("FaultAssignee", fields: [assignedToId], references: [id])
  faultTimelines FaultTimeline[]

  @@unique([tenantId, faultNumber])
  @@unique([id, tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedToId])
  @@index([tenantId, customerId])
  @@index([tenantId, slaDeadline])
  @@index([tenantId, isEscalated])
  @@map("faults")
}

model FaultTimeline {
  id                String   @id @default(uuid())
  tenantId          String
  faultId           String
  status            String
  notes             String?
  clientRef         String? // offline-sync idempotency key
  isCustomerVisible Boolean  @default(false) // portal users only see flagged entries (BRD 3.8 BR-3.4)
  createdBy         String?
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fault  Fault  @relation(fields: [faultId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, faultId])
  @@index([faultId, clientRef])
  @@map("fault_timelines")
}

// -----------------------------------------------------------------------------
// GPS VISIT MANAGEMENT (Milestone-3 3.2)
// -----------------------------------------------------------------------------

model Visit {
  id             String    @id @default(uuid())
  tenantId       String
  visitNumber    String
  visitType      String    @default("PLANNED") // PLANNED, AD_HOC, EMERGENCY, MAINTENANCE, INSPECTION, INSTALLATION, COMPLAINT, SALES, SURVEY, FOLLOW_UP
  status         String    @default("PLANNED") // lifecycle in apps/api/src/visits/domain/visit-state.ts
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  purpose        String
  description    String?
  customerId     String?
  employeeId     String?
  geofenceId     String?
  siteAddress    String?
  siteLatitude   Float?
  siteLongitude  Float?
  plannedStartAt DateTime
  plannedEndAt   DateTime?
  actualStartAt  DateTime?
  actualEndAt    DateTime?
  startLatitude  Float?
  startLongitude Float?
  endLatitude    Float?
  endLongitude   Float?
  gpsValidated   Boolean   @default(false)
  outcome        String?
  slaDeadline    DateTime?
  version        Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer?            @relation(fields: [customerId], references: [id])
  employee      Employee?            @relation(fields: [employeeId], references: [id])
  geofence      Geofence?            @relation(fields: [geofenceId], references: [id])
  statusHistory VisitStatusHistory[]
  visitNotes    VisitNote[]

  @@unique([tenantId, visitNumber])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@index([tenantId, customerId])
  @@index([tenantId, plannedStartAt])
  @@index([tenantId, createdAt])
  @@map("visits")
}

// Immutable transition log — no soft delete, never updated after insert.
model VisitStatusHistory {
  id         String   @id @default(uuid())
  tenantId   String
  visitId    String
  fromStatus String?
  toStatus   String
  notes      String?
  latitude   Float?
  longitude  Float?
  clientRef  String? // offline-sync idempotency key
  createdBy  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit  Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, visitId])
  @@index([visitId, clientRef])
  @@map("visit_status_history")
}

model VisitNote {
  id        String    @id @default(uuid())
  tenantId  String
  visitId   String
  note      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String?
  updatedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visit  Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, visitId])
  @@map("visit_notes")
}

// -----------------------------------------------------------------------------
// SPRINT 6.5: RBAC, SETTINGS, FILES
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  dataScope    String   @default("OWN") // OWN, CUSTOM, TEAM, DEPARTMENT, BRANCH, REGION, BUSINESS_UNIT, ALL (DataScope.md §4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// CUSTOM data-scope rules (DataScope.md §4/§12 — user_scope_overrides).
// Each row grants a user visibility over one target: a specific employee or
// every employee in an org unit. `module` NULL applies to all modules.
model UserScopeOverride {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  module     String? // e.g. FAULTS; NULL = every module
  scopeType  String // EMPLOYEE, TEAM, DEPARTMENT, BRANCH, REGION, BUSINESS_UNIT
  targetId   String // employee id or org-unit id, per scopeType
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  createdBy  String?
  updatedBy  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, userId])
  @@map("user_scope_overrides")
}

model TenantSetting {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  theme        String   @default("LIGHT")
  primaryColor String?
  logoUrl      String?
  timezone     String   @default("UTC")
  dateFormat   String   @default("YYYY-MM-DD")
  metadata     Json?
  // Connection Map module gating (3.7_ConnectionMap — Super Admin controlled)
  connectionMapEnabled        Boolean @default(false)
  connectionMapEmployeeAccess String  @default("NONE") // NONE, VIEW, EDIT, FULL
  // Customer Portal module gating + policy (3.8_CustomerPortal)
  customerPortalEnabled       Boolean @default(false) // Super Admin controlled
  portalMaxContacts           Int     @default(5) // max portal users per customer account
  portalFaultReopenHours      Int     @default(72) // window to reopen a resolved fault
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// -----------------------------------------------------------------------------
// NETWORK / CONNECTION MAP MODULE (3.7_ConnectionMap)
// -----------------------------------------------------------------------------

model Olte {
  id          String    @id @default(uuid())
  tenantId    String
  code        String // e.g. OLTE-001, unique per tenant
  name        String
  description String?
  status      String    @default("ACTIVE") // ACTIVE, MAINTENANCE, ARCHIVED
  totalPorts  Int       @default(0)
  usedPorts   Int       @default(0) // denormalized: root-level connections, maintained by service
  address     String?
  area        String?
  village     String?
  mandal      String?
  district    String?
  latitude    Float?
  longitude   Float?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connections NetworkConnection[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("oltes")
}

model NetworkConnection {
  id                 String    @id @default(uuid())
  tenantId           String
  connectionCode     String // CONN-xxxx, unique per tenant
  olteId             String
  customerId         String? // null = junction/splitter node
  parentConnectionId String? // null = directly off the OLTE
  path               String // materialized path of connection ids: "rootId.childId....id"
  depth              Int       @default(0)
  nodeType           String    @default("CUSTOMER") // CUSTOMER, JUNCTION, SPLITTER
  status             String    @default("ACTIVE") // ACTIVE, PENDING_INSTALLATION, SUSPENDED, DISCONNECTED, FAULTY, MAINTENANCE
  connectionType     String? // FIBER, COPPER, WIRELESS
  cableType          String?
  fiberCoreDetails   String?
  distanceMeters     Float? // parent -> this node cable length
  installationDate   DateTime?
  assignedEmployeeId String?
  latitude           Float?
  longitude          Float?
  remarks            String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  olte             Olte                @relation(fields: [olteId], references: [id])
  customer         Customer?           @relation(fields: [customerId], references: [id])
  parentConnection NetworkConnection?  @relation("ConnectionTree", fields: [parentConnectionId], references: [id])
  childConnections NetworkConnection[] @relation("ConnectionTree")

  @@unique([tenantId, connectionCode])
  @@unique([id, tenantId])
  @@index([tenantId, olteId])
  @@index([tenantId, customerId])
  @@index([tenantId, parentConnectionId])
  @@index([tenantId, status])
  @@index([tenantId, path])
  @@index([tenantId, assignedEmployeeId])
  @@index([tenantId, latitude, longitude])
  @@map("network_connections")
}

model ConnectionHistory {
  id             String   @id @default(uuid())
  tenantId       String
  connectionId   String
  action         String // CREATED, MOVED, SPLIT, MERGED, DISCONNECTED, RECONNECTED, UPDATED, ARCHIVED
  previousParent String?
  newParent      String?
  previousOlte   String?
  newOlte        String?
  previousStatus String?
  newStatus      String?
  performedBy    String
  performedAt    DateTime @default(now())
  details        Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, connectionId, performedAt])
  @@map("connection_history")
}

model FileAttachment {
  id              String   @id @default(uuid())
  tenantId        String
  entityType      String
  entityId        String
  fileName        String
  fileSize        Int
  mimeType        String
  fileUrl         String
  storageKey      String
  checksum        String? // SHA-256 of the stored bytes (Upload.md §11)
  storageProvider String   @default("LOCAL") // LOCAL, OBJECT_STORAGE
  uploadedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, checksum])
  @@map("file_attachments")
}

// -----------------------------------------------------------------------------
// SPRINT 7: WORKFLOW & NOTIFICATIONS
// -----------------------------------------------------------------------------

model NotificationTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  type      String // EMAIL, SMS, PUSH
  subject   String?
  body      String   @db.Text
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("notification_templates")
}

model NotificationLog {
  id          String    @id @default(uuid())
  tenantId    String
  recipientId String?
  type        String // EMAIL, SMS, PUSH
  subject     String?
  body        String    @db.Text
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  sentAt      DateTime?
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, recipientId])
  @@index([tenantId, status])
  @@map("notification_logs")
}

// Per-tenant SMTP provider (Email.md §5 — "Providers are configurable per
// tenant"). passwordEnc is AES-256-GCM sealed with EMAIL_CONFIG_ENCRYPTION_KEY;
// tenants without a row fall back to the global SMTP transport.
model TenantEmailConfig {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  host        String
  port        Int      @default(587)
  secure      Boolean  @default(false)
  username    String?
  passwordEnc String?
  fromAddress String
  status      String   @default("ACTIVE") // ACTIVE, DISABLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_email_configs")
}

// -----------------------------------------------------------------------------
// SUPER ADMIN MODULE (Platform-wide configuration)
// -----------------------------------------------------------------------------

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// -----------------------------------------------------------------------------
// BILLING & SUBSCRIPTIONS MODULE (Platform-wide, Super Admin owned)
// -----------------------------------------------------------------------------
// Gateway-agnostic: `gateway` + `gateway*Id` fields hold provider references so
// Razorpay (live) and Stripe (stubbed) can coexist behind one PaymentProvider
// interface. Amounts are stored in the smallest currency unit (paise/cents) as
// Int to avoid float rounding.

enum PaymentGateway {
  RAZORPAY
  STRIPE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  CREATED // subscription record made, awaiting first authorization/payment
  AUTHENTICATED // mandate authorized, not yet active
  ACTIVE
  PAST_DUE // a charge failed, in retry/grace window
  PAUSED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

/// Catalog of subscription plans sold on the public website. Seeded and managed
/// by Super Admin; read publicly by the marketing site.
model Plan {
  id            String          @id @default(uuid())
  /// Stable machine key used by the website/API (e.g. "starter", "growth").
  code          String          @unique
  name          String
  tagline       String?
  /// Price in smallest currency unit (e.g. paise). 0 = custom/contact-sales.
  amount        Int
  currency      String          @default("INR")
  interval      BillingInterval @default(MONTHLY)
  /// Feature bullet points shown on the pricing page.
  features      String[]
  maxFieldStaff Int?
  /// Marks the "Most popular" tier on the pricing page.
  highlighted   Boolean         @default(false)
  /// Custom/contact-sales plan: no gateway checkout, routes to sales instead.
  isCustom      Boolean         @default(false)
  isActive      Boolean         @default(true)
  sortOrder     Int             @default(0)

  /// Gateway-side plan ids, created lazily when a checkout is first requested.
  razorpayPlanId String?
  stripePriceId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  subscriptions TenantSubscription[]

  @@index([isActive])
  @@map("plans")
}

/// A tenant's subscription to a Plan, backed by a gateway subscription/mandate.
model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String
  planId   String

  gateway PaymentGateway
  status  SubscriptionStatus @default(CREATED)

  /// Provider-side identifiers (nullable until checkout completes).
  gatewaySubscriptionId String? @unique
  gatewayCustomerId     String?

  amount   Int
  currency String @default("INR")

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAt           DateTime?
  cancelledAt        DateTime?
  trialEnd           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         Plan                 @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@index([tenantId])
  @@index([planId])
  @@index([status])
  @@map("tenant_subscriptions")
}

/// A single payment attempt/charge against a subscription. Drives revenue
/// analytics and the audit trail; written from webhook events.
model PaymentTransaction {
  id             String  @id @default(uuid())
  tenantId       String
  subscriptionId String?

  gateway PaymentGateway
  status  PaymentStatus  @default(PENDING)

  /// Provider payment id (razorpay_payment_id / stripe payment_intent).
  gatewayPaymentId String? @unique
  gatewayInvoiceId String?

  amount   Int
  currency String @default("INR")

  /// Failure reason surfaced by the gateway, if any.
  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@map("payment_transactions")
}

/// Idempotency + audit log of raw gateway webhook events. A unique eventId stops
/// duplicate webhook deliveries from being processed twice.
model WebhookEvent {
  id        String         @id @default(uuid())
  gateway   PaymentGateway
  /// Provider event id (x-razorpay-event-id / stripe event.id).
  eventId   String         @unique
  eventType String
  payload   Json
  processed Boolean        @default(false)
  error     String?
  createdAt DateTime       @default(now())

  @@index([processed])
  @@map("webhook_events")
}
